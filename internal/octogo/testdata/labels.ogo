// COMPILE

// A label, "L:", prefixes a statement; a "break L" or "continue L" then names that
// enclosing statement instead of the innermost. "break" may name a labeled "for",
// "switch" or "select"; "continue" may name only a labeled "for".

func run() {
outer:
	for i := 0; i < 3; i++ {
		for j := 0; j < 3; j++ {
			if j == 1 {
				continue outer
			}
			if i == 2 {
				break outer
			}
		}
	}

sw:
	for i := 0; i < 3; i++ {
		switch i {
		case 1:
			break sw
		}
	}

	// Plain break and continue still work.
	for {
		break
	}
	for i := 0; i < 2; i++ {
		continue
	}
}

// A label on a select makes it a break target, as a switch's does: the break
// leaves the select from inside a loop or a switch of one of its clauses.
var lsch chan int

func breakSelect() int {
	n := 0
sel:
	select {
	case v := <-lsch:
		for i := 0; i < v; i++ {
			if i == 2 {
				break sel
			}
			n += i
		}
		switch v {
		case 1:
			break sel
		}
		n += 100
	}
	return n
}
