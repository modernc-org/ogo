// A function that declares a result must end in a terminating statement; otherwise
// control can fall off the end without returning a value ("missing return",
// reported at the closing brace). A conditionless "for" loops forever unless
// something breaks out of it; a switch terminates only with a default whose every
// clause terminates and none of which breaks out; a select terminates when its
// every clause does. A break belonging to a nested for, switch or select leaves
// that one instead, so it does not count against the outer statement.

type T struct{ v int }

// Terminating -- these compile.

func returns() int {
	return 1
}

func infiniteFor() int {
	for {
	}
}

func ifElse(c bool) int {
	if c {
		return 1
	} else {
		return 2
	}
}

func switchDefault(x int) int {
	switch x {
	case 1:
		return 1
	default:
		return 2
	}
}

func emptySelect() int {
	select {}
}

func bareBlock() int {
	{
		return 1
	}
}

func panics() int {
	panic("boom")
}

func (t T) value() int {
	return t.v
}

func noResult() {
}

// A break inside a nested for, switch or select belongs to that one, so the outer
// switch still terminates.
func breakInNestedFor(x int) int {
	switch x {
	default:
		for {
			break
		}
		return 2
	}
}

func breakInNestedSwitch(x int) int {
	switch x {
	default:
		switch x {
		default:
			break
		}
		return 2
	}
}

// Non-terminating -- control reaches the closing brace.

func emptyBody() int {
	// ERROR "missing return"
}

func ifNoElse(c bool) int {
	if c {
		return 1
	}
	// ERROR "missing return"
}

func conditionalFor(c bool) int {
	for c {
		return 1
	}
	// ERROR "missing return"
}

func switchNoDefault(x int) int {
	switch x {
	case 1:
		return 1
	}
	// ERROR "missing return"
}

func plainStatement() int {
	var x int
	_ = x
	// ERROR "missing return"
}

// A named result does not exempt a function: an explicit return is still required.
func named() (x int) {
	x = 1
	// ERROR "missing return"
}

func (t T) missing() int {
	// ERROR "missing return"
}

// A break leaves the switch, so control falls out of its bottom even though every
// clause body ends in a terminating statement. The break need not be the last
// statement of the clause for that to happen.
func breaksOutOfSwitch(x int) int {
	switch x {
	default:
		if x > 0 {
			break
		}
		return 2
	}
	// ERROR "missing return"
}

// The same for a conditionless "for".
func breaksOutOfFor(x int) int {
	for {
		if x > 0 {
			break
		}
	}
	// ERROR "missing return"
}
