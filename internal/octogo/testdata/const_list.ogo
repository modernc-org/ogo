// A const spec binds a list of identifiers to a list of expressions, which must be
// of equal length. Go names the offending side rather than counting both.

// ERROR "missing init expr for b"
const a, b = 1

// ERROR "extra init expr 2"
const c = 1, 2

// The forms that are legal, including a spec that repeats the previous list.
const d, e = 1, 2

const (
	f, g = 3, 4
	h, i
	j, k = iota, iota * 10
	l, m
)

func ok() {
	const n, o = 5, 6
	println(a, c, d, e, f, g, h, i, j, k, l, m, n, o)
}
