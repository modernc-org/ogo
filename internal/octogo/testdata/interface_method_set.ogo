// An interface's method set is what a call through a variable of that type is
// checked against, and what a value put into one has to supply.
//
// What an interface holds here is a POINTER. Go copies the value in, allocating for
// it; there is no heap on this target, so a value form would have to be a reference
// to the variable it was made from -- and assigning to that variable afterwards
// would then be visible through the interface, where Go kept the old value.
// Refusing the value form is what keeps a program that compiles here mean what it
// means in Go. So `&x`, not `x`, at every position below.

type Shape interface {
	Area() int
	Name() string
}

type Empty interface{}

type sq struct {
	n int
}

func (s sq) Area() int { return s.n * s.n }

func (s sq) Name() string { return "sq" }

// tri has no methods at all.
type tri struct {
	n int
}

// wrong has both names, one with the wrong signature.
type wrong struct {
	n int
}

func (w wrong) Area(k int) int { return w.n * k }

func (w wrong) Name() string { return "wrong" }

func main() {
	var s Shape
	var q sq
	var t tri
	var w wrong
	var e Empty

	// A method of the set is called and checked against the set's signature.
	println(s.Area(), s.Name())

	// ERROR type Shape has no method Perimeter
	println(s.Perimeter())
	// ERROR too many arguments in call to Area
	println(s.Area(1))

	// A type supplying the whole set satisfies it.
	s = &q

	// ERROR an interface holds a pointer here; write &q
	s = q

	// ERROR tri does not implement Shape \(missing method Area\)
	s = &t
	// ERROR wrong does not implement Shape \(wrong type for method Area\)
	s = &w

	// The empty interface is satisfied by everything.
	e = &q
	e = &t

	_ = e
}

// The same rule holds wherever a value meets an interface type, not only at an
// assignment: a variable declaration, an argument and a return each ask it.

func use(s Shape) int { return s.Area() }

func mk(q *sq) Shape { return q }

func bad() Shape {
	var t tri
	// ERROR in return statement: tri does not implement Shape \(missing method Area\)
	return &t
}

func badValue() Shape {
	var q sq
	// ERROR an interface holds a pointer here; write &q
	return q
}

func positions() {
	var q sq
	var t tri

	var ok1 Shape = &q
	// ERROR tri does not implement Shape \(missing method Area\)
	var bad1 Shape = &t
	// ERROR an interface holds a pointer here; write &q
	var bad2 Shape = q

	println(use(&q))
	// ERROR tri does not implement Shape \(missing method Area\)
	println(use(&t))
	// ERROR an interface holds a pointer here; write &q
	println(use(q))

	_, _, _ = ok1, bad1, bad2
}

// An interface satisfies another when its own method set contains it, which is the
// same question asked of a set rather than of a type's declared methods. No address
// is taken there: an interface value is already the two words.

type Named interface {
	Area() int
	Name() string
}

type OnlyName interface {
	Name() string
}

func sets() {
	var n Named
	var o OnlyName

	var s1 Shape = n
	// ERROR OnlyName does not implement Shape \(missing method Area\)
	var s2 Shape = o

	_, _ = s1, s2
}

// A struct field of interface type asks it too, filled by a keyed literal, by a
// positional one, or assigned afterwards. The field's declared type is what
// answers, where the positions above have a variable's or a signature's.

type box struct {
	s Shape
	k int
}

func fields() {
	var q sq
	var t tri

	ok1 := box{s: &q}
	// ERROR tri does not implement Shape \(missing method Area\)
	bad1 := box{s: &t}
	// ERROR an interface holds a pointer here; write &q
	bad2 := box{s: q}

	ok2 := box{&q, 1}
	// ERROR tri does not implement Shape \(missing method Area\)
	bad3 := box{&t, 1}

	var b box
	b.s = &q
	// ERROR tri does not implement Shape \(missing method Area\)
	b.s = &t

	_, _, _, _, _ = ok1, bad1, bad2, ok2, bad3
}

// A channel of interface type asks it as well, in a send statement and in a
// select's send clause alike, and through a defined type over one. The element's
// Kind cannot answer this -- a named interface has none -- so the element's NAME is
// what the declaration retains.

type Ch chan Shape

// The receiver may outlive this frame, so what is sent is the address of a package
// variable: the pointer rule and the lifetime rule compose, and a local would be
// refused by the second one.

var pq sq

var pt tri

func sends(ch chan Shape, dc Ch) {
	ch <- &pq
	dc <- &pq

	// ERROR an interface holds a pointer here; write &pq
	ch <- pq

	// ERROR tri does not implement Shape \(missing method Area\)
	ch <- &pt
	// ERROR tri does not implement Shape \(missing method Area\)
	dc <- &pt

	select {
	case ch <- &pq:
	// ERROR tri does not implement Shape \(missing method Area\)
	case ch <- &pt:
	}
}

// Go's method set: a value of T carries the methods declared ON T, and *T carries
// all of them. The rule still governs which methods a type supplies -- it is what
// makes the address correct -- but nothing is rejected by it any more, an interface
// taking only the pointer form, whose method set is always the whole of it.

type Mutable interface {
	Bump(k int) int
}

type counter struct {
	n int
}

func (c *counter) Bump(k int) int {
	c.n = c.n + k
	return c.n
}

var gc counter

func methodSets() {
	var m1 Mutable = &gc
	// ERROR an interface holds a pointer here; write &gc
	var m2 Mutable = gc

	_, _ = m1, m2
}

// A method PROMOTED from an embedded field is in the type's method set, so it
// satisfies an interface exactly as a declared one does. The direct call path always
// resolved these; the interface check read the type's OWN methods only, and answered
// the same question the other way.
type Emb struct {
	n int
}

func (e *Emb) get() int {
	return e.n
}

type Outer struct {
	Emb
}

type Deeper struct {
	Outer
}

type Reader interface {
	get() int
}

func promoted() {
	var o Outer
	var r Reader = &o
	_ = r

	// Two levels down is still promoted, breadth-first as Go has it.
	var d Deeper
	var r2 Reader = &d
	_ = r2
}

// A method the chain does not carry is still missing, and says so.
type NeedsTwo interface {
	get() int
	put(v int)
}

func promotedShort() {
	var o Outer
	// ERROR "does not implement NeedsTwo \(missing method put\)"
	var n NeedsTwo = &o
	_ = n
}
