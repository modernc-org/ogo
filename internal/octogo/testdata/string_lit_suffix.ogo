// A string LITERAL may be indexed and sliced where it stands, as a named constant
// may: "0123456789abcdef"[n&15] is how a digit is looked up. The grammar gave a
// string literal no suffix, so each of these was a syntax error, in a statement and
// in a header alike. What comes out is a byte or a string, and no constant.

var g = "hello"[1:3]

var tab = [2]byte{"xy"[0], "xy"[1]}

func digit(n int) byte {
	return "0123456789abcdef"[n&15]
}

func uses(n int) int {
	s := "hello"[1:][1:]
	if "abc"[0] == 'a' {
		n += len(s)
	}
	switch "abc"[1] {
	case 'b':
		n++
	}
	for i, r := range "héllo"[1:] {
		n += i + int(r)
	}
	for i := int("a"[0]); i < 100; i++ {
		n++
	}
	return n + int(`raw\n`[3])
}

// ERROR ".abc..1. is not constant"
const c = "abc"[1]

// ERROR ".abc..1:. is not constant"
const t = "abc"[1:]

func main() {
	println(g, tab[0], digit(11), uses(1))
}
