// COMPILE

// Regression: a type may reference any other type in its body -- itself
// (linked lists, trees), a type declared later (forward reference), or another
// type that references it back (mutual reference) -- resolved by the two-pass
// type checker (names first, bodies second).

type Node struct {
	val  int
	next *Node
}

type Tree struct {
	value int
	left  *Tree
	right *Tree
}

type List struct {
	items []List
}

// An embedded POINTER is a reference like any other, so a type may embed a pointer
// to itself; what it may not embed is itself (type_cycle_embedded.ogo).
type Chain struct {
	*Chain
	n int
}

// Forward and mutual references: Edge names Vertex before it is declared, and
// Vertex names Edge back.
type Edge struct {
	to *Vertex
}

type Vertex struct {
	edges []Edge
}

// A LOCAL type refers to itself on the same terms (type_cycle_local.ogo has what it
// may not do).
func local() int {
	type N struct {
		next *N
		kids []N
		v    int
	}
	var a, b N
	a.v, b.v = 1, 2
	a.next = &b
	return a.next.v + len(a.kids)
}
