// A DEFINED type is a type of its own, distinct from the type it is defined over:
// "type Celsius int" makes Celsius and int two types, and a value of one goes into
// the other only through a conversion. Go says so; here the two shared a Kind --
// typeKind resolves through the definition on purpose, so that every check keyed on
// a Kind works for a defined type at all -- which left them indistinguishable to
// the assignability check, and every position below compiled.
//
// checkDefinedType is the name-based companion that sees the difference, in the
// family of checkImplements and checkPointerValue. It answers only where the
// value's type is KNOWN: a range value, a field read and a method result carry no
// name here, and go unchecked rather than misreported.
//
// A STRUCT base needs no Kind at all, and is the reason to say so: a struct HAS
// none -- the enum names the predeclared scalars and nothing else -- so the scalar
// gate could never admit one, and "type Loc Pt" stayed interchangeable with Pt
// where "type Celsius int" had not been interchangeable with int since the day the
// rule shipped. Identity is decided by name either way.

type Celsius int

type Fahrenheit int

type Word int32

type Box struct {
	c Celsius
}

func takeInt(n int) int          { return n }
func takeC(c Celsius) Celsius    { return c }
func takeW(w Word) Word          { return w }

func giveInt() int {
	var c Celsius = 20

	// ERROR "cannot use c of type Celsius as type int in return statement"
	return c
}

func run() {
	var c Celsius = 20
	var i int = 1
	var w Word = 2
	var i32 int32 = 3

	// A conversion is how the two meet, and it is unaffected.
	i = int(c)
	c = Celsius(i)
	takeInt(int(c))
	takeC(Celsius(i))
	takeW(Word(i32))

	// An untyped constant goes into either, needing no conversion.
	c = 30
	var c2 Celsius = 40
	takeC(50)
	_ = c2

	// ERROR "cannot use c of type Celsius as type int in variable declaration"
	var bad1 int = c
	_ = bad1

	// ERROR "cannot use c of type Celsius as type int in assignment"
	i = c

	// ERROR "cannot use i of type int as type Celsius in assignment"
	c = i

	// ERROR "cannot use c of type Celsius as type int in argument to takeInt"
	takeInt(c)

	// ERROR "cannot use i of type int as type Celsius in argument to takeC"
	takeC(i)

	// Two defined types over the same underlying type are still two types.
	// ERROR "cannot use c of type Celsius as type Fahrenheit in variable declaration"
	var bad2 Fahrenheit = c
	_ = bad2

	// ERROR "cannot use i32 of type int32 as type Word in assignment"
	w = i32
	_ = w

	// An operator wants its two operands to be of one type, and a defined type is
	// not the type it is defined over.
	// ERROR "mismatched types Celsius and int"
	_ = c + i

	// ERROR "mismatched types Celsius and int"
	if c == i {
	}

	// The same operators between one type are fine, and so is an untyped operand.
	takeC(c + 1)
	takeC(c * Celsius(2))
	if c > 10 {
	}

	var b Box
	// ERROR "cannot use i of type int as type Celsius in assignment"
	b.c = i
	b.c = c
	b.c = 60

	// ERROR "cannot use i of type int as type Celsius in struct literal"
	bx := Box{c: i}
	_ = bx
	by := Box{c: c}
	_ = by

	// A field READ names its type too: the field's declared type is written down,
	// so unlike a range value it is not a silence.
	b.c = 70
	takeC(b.c)
	c = b.c

	// ERROR "cannot use b.c of type Celsius as type int in assignment"
	i = b.c
	_ = i
}

// A defined type over another defined type is that type's own, and the chain
// resolves for the Kind while the name stays what was written.
type Deep Celsius

func deep() {
	var d Deep = 1
	var c Celsius = 2

	// ERROR "cannot use c of type Celsius as type Deep in assignment"
	d = c
	d = Deep(c)
	d = 3
	_ = d
}

// The same rule over a STRUCT base.

type Pt struct {
	x int
	y int
}

type Loc Pt

// Two names over one shape are two types whether or not either was defined over
// the other, so Other is refused where a Pt is wanted exactly as Loc is.
type Other struct {
	x int
	y int
}

type Held struct {
	p Pt
}

var locs chan Loc

func takePt(p Pt) int   { return p.x }
func takeLoc(l Loc) int { return l.x }

func givePt() Pt {
	var l Loc

	// ERROR "cannot use l of type Loc as type Pt in return statement"
	return l
}

func structs() {
	var p Pt
	var l Loc
	var o Other
	var h Held

	// A conversion is how the two meet, as with a scalar base, and it is
	// unaffected.
	p = Pt(l)
	l = Loc(p)
	takePt(Pt(l))
	takeLoc(Loc(p))

	// ERROR "cannot use l of type Loc as type Pt in variable declaration"
	var bad1 Pt = l
	_ = bad1

	// ERROR "cannot use p of type Pt as type Loc in variable declaration"
	var bad2 Loc = p
	_ = bad2

	// ERROR "cannot use l of type Loc as type Pt in assignment"
	p = l

	// ERROR "cannot use p of type Pt as type Loc in assignment"
	l = p

	// ERROR "cannot use l of type Loc as type Pt in argument to takePt"
	takePt(l)

	// ERROR "cannot use p of type Pt as type Loc in argument to takeLoc"
	takeLoc(p)

	// ERROR "cannot use o of type Other as type Pt in assignment"
	p = o
	_ = o

	// Comparison wants one type between its operands, and reports the pair rather
	// than a use, there being no direction to it.
	// ERROR "mismatched types Loc and Pt"
	if l == p {
	}

	// ERROR "cannot use l of type Loc as type Pt in assignment"
	h.p = l
	h.p = p

	// ERROR "cannot use l of type Loc as type Pt in struct literal"
	bad3 := Held{p: l}
	_ = bad3
	good := Held{p: p}
	_ = good

	// ERROR "cannot use p of type Pt as type Loc in send"
	locs <- p
	locs <- l

	// One type on both sides is untouched, whichever way the value was written.
	p = Pt{1, 2}
	l = Loc{3, 4}
	takePt(p)
	takeLoc(l)
	other := p
	if p == other {
	}
	_ = p
	_ = l
}

// An ARRAY base is the struct case over again, and was left out of it: an array
// carries no Kind either, so "type Row [2]int" and "type Col [2]int" were
// interchangeable in every position the scalar gate could not see. The emitter has
// its own array checks and they compare by SHAPE, never by name -- a defined array
// type and the unnamed spelling of it are assignable both ways, as they are in Go --
// so identity has to be decided here, where the names are.

type Row [2]int

type Col [2]int

type Grid [2][2]int

type Board [2][2]int

type Frame struct {
	r Row
}

var cols chan Col

func takeRow(r Row) int { return r[0] }

func takeCol(c Col) int { return c[0] }

func giveCol() Col {
	var r Row

	// ERROR "cannot use r of type Row as type Col in return statement"
	return r
}

func arrays() {
	var r Row
	var c Col
	var g Grid
	var b Board
	var fr Frame

	// A conversion is how the two meet, and it is unaffected.
	c = Col(r)
	r = Row(c)
	takeRow(Row(c))
	takeCol(Col(r))

	// The unnamed spelling of the same shape is assignable both ways, as in Go:
	// one of the two is not a defined type, so there is nothing to tell apart.
	var plain [2]int
	plain = r
	r = plain

	// ERROR "cannot use r of type Row as type Col in variable declaration"
	var bad1 Col = r

	// ERROR "cannot use c of type Col as type Row in assignment"
	r = c

	// ERROR "cannot use r of type Row as type Col in argument to takeCol"
	takeCol(r)

	// A rank above one is no different: what is compared is the name.
	// ERROR "cannot use b of type Board as type Grid in assignment"
	g = b

	// Comparison reports the pair rather than a use, there being no direction to it.
	// ERROR "mismatched types Row and Col"
	if r == c {
	}

	// ERROR "cannot use c of type Col as type Row in assignment"
	fr.r = c
	fr.r = r

	// ERROR "cannot use c of type Col as type Row in struct literal"
	bad2 := Frame{r: c}
	_ = bad2

	// ERROR "cannot use r of type Row as type Col in send"
	cols <- r
	cols <- c

	// One type on both sides is untouched, whichever way the value was written.
	takeRow(r)
	takeCol(c)
	_ = bad1
	_ = g
	_ = plain
}
