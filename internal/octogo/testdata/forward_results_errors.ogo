// The results passed on are counted and checked as arguments are.

func divmod(a, b int) (int, int) { return a / b, a % b }

func three() (int, int, int) { return 1, 2, 3 }

func pair() (string, bool) { return "x", true }

func sum(a, b int) int { return a + b }

func add3(a, b, c int) int { return a + b + c }

func main() {
	// ERROR too many arguments in call to sum
	println(sum(three()))
	// ERROR not enough arguments in call to add3
	println(add3(divmod(1, 2)))
	// ERROR cannot use result 1 of pair\(\) \(type string\) as type int in argument to sum
	println(sum(pair()))
}
