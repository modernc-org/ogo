// A composite literal whose type is ELIDED, `[2]P{{1, 2}}`, is a literal of the
// type its position implies and is checked as one. Nothing checked it: the walk
// stopped at the element, so a value too many went through where the written form
// `P{1, 2, 3}` was refused, and a keyed element could name a field that is not
// there. Found by a cross-package probe, where the same hole let a literal fill
// ANOTHER package's unexported field -- which Go refuses and the written form was
// refused for here as well.

type Inner struct{ a, b int }

type P struct {
	x, y int
	in   Inner
}

// Every one of these is a program.
var ok1 = [2]P{{1, 2, Inner{3, 4}}, {x: 5}}

var ok2 = []P{{8, 9, Inner{1, 1}}, {}}

var ok3 = [2][2]int{{1, 2}, {3, 4}}

func values() {
	// ERROR "too many values in P{...}: 4 values but 3 fields"
	a := [1]P{{1, 2, Inner{3, 4}, 5}}
	// ERROR "not enough values in P{...}: 2 values but 3 fields"
	b := []P{{1, 2}}
	// ERROR "unknown field nope in struct literal of type P"
	c := [1]P{{nope: 1}}
	println(a[0].x, b[0].y, c[0].x)
}

// A FIELD's value whose own type is elided is the same shape: the field's type is
// what it is a literal of, and the walk stopped there too.
type Outer struct {
	tag string
	in  Inner
}

var ok4 = Outer{"t", {1, 2}}

var ok5 = Outer{tag: "u", in: {a: 3}}

func fields() {
	// ERROR "too many values in Inner{...}: 3 values but 2 fields"
	a := Outer{"t", {1, 2, 3}}
	// ERROR "unknown field nope in struct literal of type Inner"
	b := Outer{tag: "u", in: {nope: 1}}
	println(a.in.a, b.in.b)
}

// And a literal elided TWICE, whose own element type is an array or a slice: the
// innermost is a literal of the element's element, one step further in.
var ok6 = [2][2]P{{{1, 2, Inner{3, 4}}}}

var ok7 = [2][]P{{{4, 5, Inner{6, 7}}}}

func nested() {
	// ERROR "too many values in P{...}: 4 values but 3 fields"
	a := [1][2]P{{{1, 2, Inner{3, 4}, 5}}}
	// ERROR "too many values in P{...}: 4 values but 3 fields"
	b := [1][]P{{{1, 2, Inner{3, 4}, 5}}}
	println(a[0][0].x, b[0][0].y)
}

func main() {
	println(ok1[0].x, ok2[0].y, ok3[1][1], ok4.in.b, ok5.in.a, ok6[0][0].x, ok7[0][0].y)
	nested()
	values()
	fields()
}
