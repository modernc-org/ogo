// A type switch case may name an INTERFACE, written bare: `case T:`. It matches on
// the METHOD SET -- any dynamic type implementing T takes the clause -- where a
// concrete case, `case *X:`, matches one type. The two spellings differ by the star
// for that reason: what an interface holds here is a pointer, so a concrete case
// names one, and an interface case names the interface itself.
//
// Because it matches a set, the ORDER of the clauses decides between two interfaces
// one type satisfies: the first that matches wins, as in Go.

type T interface {
	foo()
}

type U interface {
	bar()
}

type Both interface {
	foo()
	bar()
}

type X int

func (*X) foo() {
}

func (*X) bar() {
}

func ok(v any) {
	switch t := v.(type) {
	case Both:
		t.foo()
	case T:
		t.foo()
	case U:
		_ = t
	case *X:
		t.foo()
	case nil:
		_ = t
	default:
		_ = t
	}
}

// A case naming neither a pointer, an interface, nor nil is refused, and the
// message says all three.
func bad(v any) {
	switch v.(type) {
	// ERROR "a type switch case names a pointer type, an interface type, or nil"
	case 1:
	}
}

// Naming one interface twice is a duplicate, as naming one type twice is.
func dup(v any) {
	switch v.(type) {
	case T:
	// ERROR "duplicate case T in type switch"
	case T:
	}
}

// A type ASSERTION to an interface asks the same question of one type, and is
// written without a star for the same reason: "*T" would be a pointer to the
// interface. Both forms are legal.
func assertion(v any) {
	t := v.(T)
	t.foo()

	u, ok := v.(U)
	_, _ = u, ok
}

// Asserting to a CONCRETE type still wants the star, and says so when it is
// missing: a struct or defined type is not what an interface holds.
type P struct {
	n int
}

func concrete(v any) {
	// ERROR "an interface holds a pointer here; assert \*P"
	p := v.(P)
	_ = p
}

// A type switch guard IS the statement, so nothing may follow it: Go has no
// meaning for "switch x := v.(type); x {" and neither has this. It used to be read
// as an ordinary type switch with the tag ignored, which compiled a program Go
// rejects -- and gave the right answer, which is the worst way to be wrong.
func guardTag(v any) {
	// ERROR "a type switch guard takes no expression after it"
	switch x := v.(type); x {
	case T:
		_ = x
	}
}

// An interface may EMBED others, contributing their methods to its own. Two that
// declare the same method overlap, which Go allows and which becomes one method.
type Both2 interface {
	T
	U
}

type Overlap interface {
	T
	Both2
}

func embedded(v any) {
	switch x := v.(type) {
	case Overlap:
		x.foo()
		x.bar()
	}
}

// Embedding itself, directly or through another, defines a method set in terms of
// itself. walkTypeCycle stops at an interface -- one is a fixed size whatever it
// carries -- so this is checked on its own.
// ERROR "invalid recursive type SelfA"
type SelfA interface {
	SelfB
}

// ERROR "invalid recursive type SelfB"
type SelfB interface {
	SelfA
}

// Assigning one interface to another is WIDENING: allowed when the target's method
// set is a subset of the source's. The other direction needs an assertion, and
// saying so is the checker's, in Go's words.
func widen() {
	var x X
	var b Both2 = &x
	var t T = b
	var u U = b
	var e any = b
	_, _, _ = t, u, e

	// ERROR "does not implement Both2 \(missing method bar\)"
	var back Both2 = t
	_ = back
}

// A suffix may be applied to an assertion's result where it stands, and is checked
// against the ASSERTED type rather than the operand's -- which is what "type any
// has no method foo" was.
type Rec struct {
	n int
}

func (r *Rec) get() int {
	return r.n
}

func chained(v any) int {
	v.(*Rec).n = 1
	return v.(*Rec).get() + v.(*Rec).n
}

func chainedBad(v any) {
	// ERROR "type Rec has no method nosuch"
	_ = v.(*Rec).nosuch()
	// ERROR "type Rec has no field nofield"
	_ = v.(*Rec).nofield
}
