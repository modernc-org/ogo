// COMPILE
// What Go takes of a typed float made whole by its rounding.

const B float64 = 0.1

const F float32 = 0.1

const K2 = int(B * 10 * 3)

const K3 = int(F * 3 * 11 * 10)

const K5 = int(0.1 * 3 * 10)

var a [int(B*30)]int

const Big float64 = 1<<53 + 1

const K6 = int64(Big)

func main() {
	println(K2, K3, K5, len(a), K6)
}
