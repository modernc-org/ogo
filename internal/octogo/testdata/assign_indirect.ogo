// Assignment to a dereference "*p" or an element "a[i]" target is type-checked:
// the right-hand side must be assignable to the pointed-to or element type, and
// the base must actually be a pointer or an array.

func ptrs() {
	var val int
	var p *int = &val

	// A value of the pointed-to type is fine.
	*p = 5

	// ERROR "cannot use true of type bool as type int in assignment"
	*p = true

	// A dereference of a non-pointer is invalid.
	var x int
	// ERROR "invalid operation: cannot indirect x"
	*x = 1
	_ = x

	// The base of a dereference target must be defined.
	// ERROR "undefined: q"
	*q = 1
}

func arrays() {
	var a [3]int

	// A value of the element type is fine.
	a[0] = 4

	// ERROR "cannot use true of type bool as type int in assignment"
	a[1] = true

	// Indexing a non-array is invalid.
	var n int
	// ERROR "invalid operation: cannot index n"
	n[0] = 1
	_ = n
}

// A dereference reaching its pointer through a FIELD is the field's, not the head's,
// the "*" binding looser than the selector. What is written through is the pointee,
// so the value is checked against its type -- which nothing asked before, so
// `*h.p = "s"` was reported by the C compiler and not here.
type holder struct {
	p *int
	v int
}

func fields() {
	var val int
	var h holder
	h.p = &val

	*h.p = 5

	// ERROR "cannot use true of type bool as type int in assignment"
	*h.p = true

	// ERROR "invalid operation: cannot indirect h.v"
	*h.v = 1
}
