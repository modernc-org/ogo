// A "for ... range" loop iterates over an integer, a slice or an array. Ranging an
// integer yields only the index; a slice or array also offers the element as a
// second variable. A variable introduced by ":=" in the header is scoped to the
// loop.

func over_int() {
	sum := 0
	for i := range 5 {
		sum = sum + i
	}
	println(sum)
}

func over_slice() {
	s := make([]int, 3, 3)
	for i, v := range s {
		println(i + v)
	}
}

func no_variable() {
	n := 0
	for range 4 {
		n++
	}
	println(n)
}

// Ranging an integer permits only the index.
func int_two_vars() {
	// ERROR "range over integer permits only one iteration variable"
	for i, v := range 3 {
		println(i + v)
	}
}

// Ranging a channel receives until it is CLOSED, which is what close is for. The
// single variable holds the ELEMENT -- a channel has no index to put in a first one
// -- so a second is refused, as it is for a range over an integer.
func over_channel() {
	var ch chan int
	for v := range ch {
		println(v)
	}
	for range ch {
		println("one")
	}
	var last int
	for last = range ch {
	}
	println(last)
	// ERROR "range over a channel permits only one iteration variable"
	for k, v := range ch {
		println(k, v)
	}
}
