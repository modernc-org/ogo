// A for clause's post that steps a target of no Kind -- a pointer, a slice, a
// function -- is refused, as the statement form is. The post's check asked only
// for a type it could name, which none of these has, so `for ...; p++` for a
// pointer reached the C compiler and was built into pointer arithmetic in silence.

func main() {
	var p *int
	// ERROR operator \+\+ not defined on p: it is a pointer
	for i := 0; i < 1; p++ {
		i++
	}
	var q []int
	// ERROR operator \+ not defined on q: it is a slice
	for i := 0; i < 1; q += 1 {
		i++
	}
	var fn func()
	// ERROR operator -- not defined on fn: it is a function
	for i := 0; i < 1; fn-- {
		i++
	}
	n := 0
	for i := 0; i < 3; n++ {
		i++
	}
	println(n)
}
