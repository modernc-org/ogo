// A composite literal's VALUES are checked against the types of the fields they
// land in, positionally or by key -- the same question an assignment to the field
// asks. Until this ran, a literal was checked for its field NAMES and its value
// COUNT and for nothing about the values themselves, so "S{f: true}" put a bool in
// an int32 field and compiled.

type S struct {
	f int32
	g uint8
	n int
	s string
	b bool
}

// A field whose type the Kind model does not carry is left alone rather than
// misreported, so a literal naming one of these still passes.
type Holder struct {
	inner S
	xs    []int
	arr   [2]int
	p     *S
}

func ok() {
	var n int = 1
	var i32 int32 = 1
	s := S{i32, 2, n, "x", true}
	t := S{f: i32, n: n, s: "y"}
	// An untyped constant goes wherever it fits, whatever the field's width.
	u := S{1, 2, 3, "z", false}
	println(s.n, t.n, u.n)

	var h Holder
	v := Holder{inner: s, p: &h.inner}
	println(v.inner.n)
}

func wrongType() {
	var n int = 1

	// ERROR "cannot use true of type bool as type int32 in struct literal"
	a := S{f: true}

	// ERROR "cannot use n of type int as type int32 in struct literal"
	b := S{f: n}

	// ERROR "cannot use n of type int as type int32 in struct literal"
	c := S{n, 1, 1, "", false}

	// ERROR "cannot use 1 of type int as type string in struct literal"
	d := S{s: 1}

	println(a.f, b.f, c.f, d.f)
}

// A constant that is of the right type may still not fit the field, which is the
// same range check every other assignment position makes.
func overflows() {
	// ERROR "constant 300 overflows uint8"
	a := S{g: 300}
	println(a.g)
}

// An ARRAY or SLICE literal's values are checked the same way, against the element
// type the literal writes down. Nothing checked them at all: the values of such a
// literal were left to the emitter, which knows the bound and counts them, and knows
// nothing about their types -- so a string in an []int reached the C compiler, and an
// element of the wrong DEFINED type was accepted outright.

type Row [2]int

type Col [2]int

type A struct {
	n int
}

type B struct {
	n int
}

type Table [1]Col

func elems() {
	var i32 int32 = 1
	var r Row
	var a A
	var plain [2]int

	// The element type takes a value of exactly it, an untyped constant that fits,
	// and -- for a named element -- the unnamed spelling of the same shape, which Go
	// assigns both ways. A type-elided element names no type and is not this check's.
	ok1 := []int{1, 2, 3}
	ok2 := []int32{i32, 2}
	ok3 := []Row{r, plain}
	ok4 := [][2]int{r}
	ok5 := []A{a, {2}}
	ok6 := [2][2]int{{1, 2}, {3, 4}}
	ok7 := Table{Col{1, 2}}
	println(ok1[0], ok2[0], ok3[0][0], ok4[0][0], ok5[0].n, ok6[0][0], ok7[0][0])

	// ERROR "of type string as type int in array or slice literal"
	bad1 := []int{1, "x"}

	// ERROR "of type string as type int in array or slice literal"
	bad2 := [2]int{1, "x"}

	// ERROR "cannot use r of type Row as type Col in array or slice literal"
	bad3 := []Col{r}

	// ERROR "cannot use a of type A as type B in array or slice literal"
	bad4 := []B{a}

	// A defined ARRAY type's literal is checked at its elements too, which is where
	// the element type is written.
	// ERROR "cannot use r of type Row as type Col in array or slice literal"
	bad5 := Table{r}

	println(bad1[0], bad2[0], bad3[0][0], bad4[0].n, bad5[0][0])
}

// A constant of the right type may still not fit the element, the same range check
// a field's value takes.
func elemOverflows() {
	// ERROR "constant 300 overflows uint8"
	a := []uint8{300}
	println(a[0])
}

func main() {
	ok()
	wrongType()
	overflows()
	elems()
	elemOverflows()
}
