// COMPILE

// A call of several results may stand as the whole argument list of another
// call, Go's special case: the results are the arguments.

type Pt struct {
	x, y int
}

func (p Pt) parts() (int, int) { return p.x, p.y }

func divmod(a, b int) (int, int) { return a / b, a % b }

func three() (int, int, int) { return 1, 2, 3 }

func pair() (string, bool) { return "x", true }

func sum(a, b int) int { return a + b }

func add3(a, b, c int) int { return a + b + c }

func show(s string, ok bool) { println(s, ok) }

func main() {
	p := Pt{1, 2}
	println(sum(divmod(17, 5)), add3(three()), sum(p.parts()), sum(sum(1, 2), 3))
	show(pair())
}
