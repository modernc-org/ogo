// A typed constant's arithmetic past its type is refused at every step of the
// fold, wherever the expression stands: a condition, a switch's tag, a case
// and an index ask it as an assignment and an argument do. scrypt's parameter
// check, mutated, `N > maxInt*128/r` in an if's condition, built, the C
// wrapping the constant (dom122).

const maxInt = int(^uint(0) >> 1)

const c8 int8 = 127

const u8 uint8 = 255

const u32 uint32 = 1<<32 - 1

func run(n, r int, v8 int8, w8 uint8, w32 uint32) {
	// ERROR "constant 274877906816 overflows int"
	if n > maxInt*128/r {
		println("big")
	}
	if n > maxInt/128/r {
		println("fits")
	}
	// ERROR "constant 381 overflows int8"
	for i := 0; v8 > c8*3/v8 && i < 1; i++ {
		println("loop")
	}
	// ERROR "constant 256 overflows uint8"
	switch w8 + (u8 + 1) {
	case 0:
		println("zero")
	}
	switch w8 {
	// ERROR "constant 1020 overflows uint8"
	case u8 << 2:
		println("hit")
	case u8 >> 2:
		println("quarter")
	}
	var a [4]int
	// ERROR "constant 4294967296 overflows uint32"
	println(a[(w32+(u32+1))&3])
	println(a[(w32+(u32-1))&3])
}

func main() {
	run(1, 1, 1, 1, 1)
}
