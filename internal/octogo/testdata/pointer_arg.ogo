// Pointer-ness must match wherever a value is assigned to something of a known
// type: an argument, a variable declaration and a return. It was checked nowhere, so
// the most common mistake in the language -- f(p) where f wants *P -- reached the C
// compiler, which then complained about C the program never wrote.
//
// An ASSIGNMENT is not among them. Its check sees only the target's base name, so a
// field or an indexed target ("bf.b[i] = c") would be compared against the base's
// type; separating the two is a change to that check rather than an addition to it.

type P struct{ n int }

func byVal(p P) int  { return p.n }
func byPtr(p *P) int { return p.n }
func viaInt(p *int) int { return *p }

var g P

func badReturn() *P { 
	// ERROR "cannot use g \(a value\) as \*P value in return statement"
	return g
}

func badDecl() {
	// ERROR "cannot use g \(a value\) as \*P value in variable declaration"
	var q *P = g
	println(q.n)
}

func bad() {
	var p P = P{1}
	var n int = 1
	// ERROR "cannot use p \(a value\) as \*P value in argument to byPtr"
	println(byPtr(p))
	// ERROR "cannot use &p \(an address\) as P value in argument to byVal"
	println(byVal(&p))
	// ERROR "cannot use n \(a value\) as \*int value in argument to viaInt"
	println(viaInt(n))
}

// Every matching call, including one through a pointer variable rather than a
// literal address.
func ok() {
	var p P = P{1}
	var q *P = &p
	var n int = 1
	println(byVal(p), byPtr(&p), byPtr(q), viaInt(&n))
}
