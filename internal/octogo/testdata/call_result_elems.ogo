// What Go refuses of the value steps past a call reach, which the checker gave no
// type: an element of a call's slice, array or pointer to an array, named or not,
// through a function, a method, a function value and a call's own result; a range
// over one; a variable declared from one; a field of a struct element; and the
// arguments of a call through a function value reached by an index or a call.

type A int

type B int

type Row [4]int

type L []A

type P struct {
	x int
	s string
}

type Handler func(n int) int

type H struct{ n int }

type W struct{ tab [2]Handler }

func (a A) Twice() A { return a * 2 }

func inc(n int) int { return n + 1 }

var g [4]int

var ga = [3]A{1, 2, 3}

var gp = [2]P{{1, "a"}, {2, "b"}}

var gg = [2][3]int{{1, 2, 3}, {4, 5, 6}}

var gr Row

var handlers = [2]Handler{inc, inc}

var gw = W{[2]Handler{inc, inc}}

var gh H

func fs() []int { return g[:] }

func fa() [4]int { return g }

func fpa() *[4]int { return &g }

func frow() *Row { return &gr }

func fl() L { return L(ga[:]) }

func fas() []A { return ga[:] }

func fp() []P { return gp[:] }

func fg() [][3]int { return gg[:] }

func pick() Handler { return inc }

func hs() []Handler { return handlers[:] }

func pw() *W { return &gw }

func (h *H) rows() *[2][3]int { return &gg }

func take(s string) {}

func elem() string {
	// ERROR "cannot use fs\(\)\[0\] of type int as type string in return statement"
	return fs()[0]
}

func main() {
	// ERROR "cannot use fs\(\)\[0\] of type int as type string in variable declaration"
	var s1 string = fs()[0]
	// ERROR "cannot use fa\(\)\[1\] of type int as type bool in variable declaration"
	var b1 bool = fa()[1]
	// ERROR "cannot use fpa\(\)\[2\] of type int as type string in variable declaration"
	var s2 string = fpa()[2]
	// ERROR "cannot use frow\(\)\[3\] of type int as type string in variable declaration"
	var s3 string = frow()[3]
	// ERROR "cannot use gh.rows\(\)\[0\]\[1\] of type int as type string in variable declaration"
	var s4 string = gh.rows()[0][1]
	fv := fpa
	// ERROR "cannot use fv\(\)\[0\] of type int as type string in variable declaration"
	var s5 string = fv()[0]
	// ERROR "non-bool used as if condition"
	if fs()[0] {
	}
	// ERROR "cannot use fs\(\)\[0\] of type int as type string in argument to take"
	take(fs()[0])
	for _, v := range fpa() {
		// ERROR "cannot use v of type int as type string in variable declaration"
		var s6 string = v
		_ = s6
	}
	for _, r := range fg() {
		// ERROR "cannot use r\[0\] of type int as type string in variable declaration"
		var s7 string = r[0]
		_ = s7
	}
	for _, r := range gg {
		// ERROR "cannot use r\[1\] of type int as type string in variable declaration"
		var s8 string = r[1]
		_ = s8
	}
	xs := fs()
	// ERROR "cannot use xs\[0\] of type int as type string in variable declaration"
	var s9 string = xs[0]
	ys := fpa()[1:]
	// ERROR "cannot use ys\[0\] of type int as type string in variable declaration"
	var s10 string = ys[0]
	// ERROR "cannot use fas\(\)\[0\] of type A as type B in variable declaration"
	var b2 B = fas()[0]
	// ERROR "cannot use fas\(\)\[0\].Twice\(\) of type A as type B in variable declaration"
	var b3 B = fas()[0].Twice()
	zs := fl()[1:]
	// ERROR "cannot use zs \(variable of type L\) as \[\]B value in variable declaration"
	var bs []B = zs
	// ERROR "cannot use fp\(\)\[0\].x of type int as type string in variable declaration"
	var s11 string = fp()[0].x
	// ERROR "non-bool used as if condition: fp\(\)\[0\] is a struct"
	if fp()[0] {
	}
	for _, p := range fp() {
		// ERROR "cannot use p.s of type string as type int in variable declaration"
		var n int = p.s
		_ = n
	}
	// ERROR "cannot use .x. of type string as type int in argument to handlers\[0\]"
	println(handlers[0]("x"))
	// ERROR "cannot use .x. of type string as type int in argument to hs\(\)\[1\]"
	println(hs()[1]("x"))
	// ERROR "cannot use .x. of type string as type int in argument to pick\(\)"
	println(pick()("x"))
	// ERROR "too many arguments in call to pick\(\)"
	println(pick()(1, 2))
	// ERROR "cannot use .x. of type string as type int in argument to pw\(\).tab\[0\]"
	println(pw().tab[0]("x"))
	// ERROR "cannot use pick\(\)\(1\) of type int as type string in variable declaration"
	var s12 string = pick()(1)
	_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _ = s1, b1, s2, s3, s4, s5, s9, s10, b2, b3, bs, s11, s12, xs, ys, zs
}
