// `type A = B` declares another NAME for B, not a new type: values pass between
// the two spellings, B's methods are reachable through A, and a method declared ON
// A is B's where B is a type defined in this package -- the receiver's base type is
// what the alias denotes. One on an alias of a predeclared type is a method of
// int32, which no package may declare. The target must be a named type of this
// package or a predeclared one.

type point struct {
	x, y int32
}

func (p point) sum() int32 { return p.x + p.y }

type spot = point

type alias2 = spot

type MyInt = int32

type reader interface {
	read() int32
}

type view = reader

func ok() {
	s := spot{x: 1, y: 2}
	var p point = s
	println(s.sum(), p.sum())

	var m MyInt = 3
	var i int32 = m
	println(m, i)

	t := alias2{x: 4, y: 5}
	println(t.sum())
}

func (s spot) first() int32 { return s.x }

func useFirst() int32 { return point{x: 3}.first() }

// ERROR "cannot define new methods on non-local type MyInt"
func (m MyInt) bad() int32 { return int32(m) }

// ERROR "cannot alias a type literal yet"
type lit = struct {
	n int32
}

// ERROR "alias cycle: selfish names itself"
type selfish = selfish
