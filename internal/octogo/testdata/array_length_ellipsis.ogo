// An array literal's length may be written "...", and is then the length the literal
// supplies. That length exists only for a literal, so "[...]T" anywhere else is
// refused in Go's words, at its opening bracket -- as a value, and as the type of a
// conversion.

var table = [...]int{3, 1, 4, 1, 5}

func refused(xs []int) {
	// ERROR invalid use of \[\.\.\.\] array \(outside a composite literal\)
	x := [...]int
	_ = x
	// ERROR invalid use of \[\.\.\.\] array \(outside a composite literal\)
	y := ([...]int)(xs)
	_ = y
}

func main() {
	refused(table[:0])
}
