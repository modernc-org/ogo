// Reading an index of a scalar -- "x[i]" where x is a numeric or bool variable or
// constant, not an array or slice -- is invalid ("cannot index x"), the read-side
// analogue of the "x[i] = e" target check in assign_indirect.ogo. A string is
// byte-indexable, so "s[i]" is left alone, and an array or slice carries its element
// type and is handled by read_index_deref.ogo. The base's own definedness is checked
// separately (read_base.ogo).

const answer = 42

func scalarIndex() {
	var n int
	var b bool
	var s string
	var a [3]int

	// The type is named, as Go names it: the operation is refused BECAUSE of the
	// type, and the type is the part the reader does not already have.
	// ERROR "invalid operation: cannot index n \(variable of type int\)"
	_ = n[0]
	// ERROR "invalid operation: cannot index b \(variable of type bool\)"
	_ = b[0]
	// ERROR "invalid operation: cannot index answer \(variable of type int\)"
	_ = answer[0]

	// A SLICE expression says slice, not index: the verb follows the operation
	// written. Saying the other one names something the program does not contain.
	// ERROR "invalid operation: cannot slice n \(variable of type int\)"
	_ = n[0:1]
	// ERROR "invalid operation: cannot slice b"
	_ = b[:]

	// A string is byte-indexable, and an array is indexable: both are fine. So is
	// slicing either of them.
	_ = s[0]
	_ = a[0]
	_ = s[0:1]
	_ = a[:]

	_ = n
	_ = b
	_ = s
	_ = a
}

// The check fires wherever the scalar index is read: an argument, a condition, and
// through a leading index that precedes a further selector or call.
func scalarIndexPositions(p int) {
	// ERROR "invalid operation: cannot index p"
	use(p[0])
	// ERROR "invalid operation: cannot index p"
	if p[0] == 0 {
	}
	// ERROR "invalid operation: cannot index p"
	_ = p[0].field
}

func use(i int) {}
