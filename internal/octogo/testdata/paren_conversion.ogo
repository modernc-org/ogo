// A conversion to a type named in parentheses, `(int)(f)` -- the spelling a C cast
// suggests -- is the conversion `int(f)`, asked what one is. Its type was taken for
// a value: "cannot use type int as a value".

type MyInt int

type Ints []int

func (l Ints) Sum() int { return len(l) }

func main() {
	f := 2.5
	v := []int{1, 2}
	n := (int)(f)
	m := (MyInt)(3)
	k := ((int))(f)
	s := (Ints)(v).Sum()
	// ERROR "cannot convert .abc. \(untyped string constant\) to type int"
	a := (int)("abc")
	// ERROR "constant 300 overflows uint8"
	b := (uint8)(300)
	// ERROR "too many arguments in conversion to int"
	c := (int)(1, 2)
	// ERROR "cannot convert true \(untyped bool constant\) to type MyInt"
	d := (MyInt)(true)
	_, _, _, _, _, _, _, _ = n, m, k, s, a, b, c, d
}
