// A switch with NO condition is a switch on true, so every case is a boolean
// expression. Nothing asked: the case check is keyed on the GUARD's Kind and there
// is no guard, so `case n:` for an int n became `if (n)` in C -- which C takes and
// Go does not.

var s = "ab"

var fl float32 = 1

func main() {
	n := 5
	b := true
	switch {
	// ERROR "cannot use n of type int as type bool in case"
	case n:
	// ERROR "cannot use s of type string as type bool in case"
	case s:
	// ERROR "cannot use fl of type float32 as type bool in case"
	case fl:
	}
	// What a conditionless switch takes: a comparison, a bool, several per case.
	switch {
	case n > 3:
		println("big")
	case b, s == "ab":
		println("other")
	default:
		println("small")
	}
	// A switch WITH a guard is unchanged: its cases are of the guard's type.
	switch n {
	case 5:
		println("five")
	// ERROR "cannot use "x" of type string as type int in case"
	case "x":
	}
}
