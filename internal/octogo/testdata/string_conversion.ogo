// A string conversion whose result is of UNBOUNDED length -- string(b) from a byte
// slice, whose bytes are as many as the slice is long -- has nowhere to put them on
// this allocation-free target, exactly as runtime string concatenation has not, so
// it is refused with a clear message rather than an opaque emit error.
//
// A conversion from a RUNE is bounded at four bytes, so it takes them from the frame
// and the lifetime rules police the result: it may be printed, compared, switched on
// and passed, and may not be returned, stored where it outlives its block, sent, or
// handed to a cog.
//
// A CONSTANT operand is a different matter and is not refused: Go makes string('A')
// a constant string, and the emitter folds it to the literal bytes, so there is
// nothing to allocate or copy. Its RANGE is not checked against rune either -- Go
// converts an integer constant too large for one to "�" rather than failing,
// and writing rune(1 << 40) is what fails, at that conversion.
//
// A conversion that builds nothing is free and is not refused: string(s) of a string
// is the same bytes, and so is one of a named type over string. Numeric conversions
// (int, float64, the sized and named types) are unaffected.

type Name string

func run() {
	r := 66

	// A RUN-TIME rune converts: its UTF-8 is at most four bytes, which the emitter
	// takes from the frame and the lifetime rules then police.
	s := string(rune(r))
	_ = s

	// Numeric conversions remain valid.
	x := 3.9
	_ = int(x)
	_ = float64(r)
	_ = uint8(r)
}

// A constant operand converts at compile time, in every spelling of one.
const bang = '!'
const code = 0x4E16

func folded() {
	_ = string('A')
	_ = string(rune(66))
	_ = string(67)
	_ = string(bang)
	_ = string(code)
	_ = string('x' + 1)
	_ = "hi" + string('!')

	// Out of rune range is "�", not an error -- the conversion is to string.
	_ = string(1 << 40)
	_ = string(-1)
}

// The explicit rune conversion is where an overflowing constant is reported, and it
// is reported there whether or not a string conversion encloses it.
func overflow() {
	// ERROR "constant 1099511627776 overflows rune"
	_ = string(rune(1 << 40))
}

// The free conversions. string(b) from a byte slice is refused too, but by the
// emitter: the checker carries no slice type to tell a byte slice from a string, so
// it says nothing rather than guess (see TestEmitCStringConvRefused).
func free() {
	var t string = "hi"
	var n Name = "hi"
	_ = string(t)
	_ = string(n)
	_ = Name(t)
	_ = bool(true)
}
