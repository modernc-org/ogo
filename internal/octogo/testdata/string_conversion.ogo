// A string conversion that BUILDS a string -- string(r) from a rune, string(b) from
// a byte slice -- must copy its bytes somewhere. The allocation-free target has
// nowhere to put them, exactly as runtime string concatenation does, so it is
// refused with a clear message rather than an opaque emit error.
//
// A conversion that builds nothing is free and is not refused: string(s) of a string
// is the same bytes, and so is one of a named type over string. Numeric conversions
// (int, float64, the sized and named types) are unaffected.

type Name string

func run() {
	r := 66

	// ERROR "a string conversion needs allocation"
	s := string(rune(r))
	_ = s

	// Numeric conversions remain valid.
	x := 3.9
	_ = int(x)
	_ = float64(r)
	_ = uint8(r)
}

// The free conversions. string(b) from a byte slice is refused too, but by the
// emitter: the checker carries no slice type to tell a byte slice from a string, so
// it says nothing rather than guess (see TestEmitCStringConvRefused).
func free() {
	var t string = "hi"
	var n Name = "hi"
	_ = string(t)
	_ = string(n)
	_ = Name(t)
	_ = bool(true)
}
