// A type is not an expression. A bracketed one standing as a value -- `x := []int`,
// `take([3]int)`, `len([]int)`, `return []int` -- reached the emitter until
// 2026-09-21, which refused it as whatever it met first, "cannot infer a type" or
// "unsupported operand '['". `[]func()(fs)` is one too: a type whose result is fs,
// which is how Go reads it. make's first argument is a type, and so is the one a
// parenthesised conversion converts to.

func take(a [3]int) int { return a[0] }

func get() []int {
	// ERROR "cannot use type \[\]int as a value"
	return []int
}

func main() {
	var fs []func()
	// ERROR "cannot use type \[\]int as a value"
	x := []int
	// ERROR "cannot use type \[3\]int as a value"
	_ = take([3]int)
	// ERROR "cannot use type \[\]int as a value"
	println(len([]int))
	// ERROR "cannot use type \[\]func\(\)\(fs\) as a value"
	gs := []func()(fs)
	s := make([]int, 2)
	t := ([]int)(s)
	u := ([3]int)(s)
	_, _, _, _, _ = x, gs, s, t, u
}
