// A channel held in a struct field. A channel is a pointer to its rendezvous cell,
// so a field holding one is an ordinary reference: the struct type allocates
// nothing, the declaration of a VARIABLE owns a cell per channel field, and a copy
// of the variable shares the channel -- which is what a copy of a channel does in
// Go too.

type ports struct {
	tx chan int
	rx chan int
	n  int
}

type Ch chan int

type named struct {
	c Ch
}

var p ports

var nm named

func ok() {
	p.tx <- 1
	println(<-p.rx)

	// A defined type over a channel is a channel here as much as anywhere.
	nm.c <- 2
	println(<-nm.c)

	// A local struct's declaration owns cells too.
	var q ports
	q.tx = p.tx
	println(<-q.rx)
}

// A select's clauses take a field as readily as a variable -- a receive binding a
// value, a send, and a bare receive -- which is what a driver's ports want: several
// channels belonging to one thing, waited on together.

func selects() {
	select {
	case v := <-p.tx:
		println(v)
	case p.rx <- 1:
	case <-nm.c:
	default:
	}
}

func selectNotAChannel() {
	select {
	// ERROR invalid operation: cannot receive from non-channel
	case v := <-p.n:
		println(v)
	default:
	}
}

// An ARRAY of such structs is a worker per element, each with channels of its own:
// the array's declaration owns a cell per element per field. A constant index and a
// variable one resolve the same way -- what the field IS never varies with the
// index, only which cell it names.

var ws [2]ports

func elements() {
	ws[0].tx <- 1
	println(<-ws[1].rx)

	for i := 0; i < 2; i++ {
		ws[i].tx <- i
	}

	select {
	case v := <-ws[0].rx:
		println(v)
	default:
	}
}

func notAChannel() {
	// ERROR invalid operation: cannot send to non-channel
	p.n <- 1
}

func wrongElement() {
	// ERROR cannot use "s" of type string as type int in send
	p.tx <- "s"
}

// A channel two fields deep. The send's model carried ONE field and looked its name
// up on the head's type, so `d.in.cmd <- v` was checked against a `cmd` field of the
// OUTER struct -- refused outright where there was none, and checked against the
// wrong element type where there was one of another type. The whole run is walked
// now, so the channel checked is the channel sent on.

type inner struct {
	cmd chan int
	tag string
}

type deep struct {
	in  inner
	cmd chan string
	n   int
}

var d deep

func nestedOK() {
	d.in.cmd <- 1
	d.cmd <- "s"
}

func nestedWrongElement() {
	// The outer struct has a `cmd` of its own, of another element type. Checking
	// against that one is exactly what this used to do.
	// ERROR cannot use "s" of type string as type int in send
	d.in.cmd <- "s"
}

func nestedNotAChannel() {
	// ERROR invalid operation: cannot send to non-channel
	d.in.tag <- 1
}

func nestedUnknownField() {
	// ERROR invalid operation: cannot send to non-channel
	d.in.nosuch <- 1
}
