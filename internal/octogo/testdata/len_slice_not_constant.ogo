// len of a SLICE EXPRESSION is never a constant, whatever it slices. The fold that
// makes `len(rows)` a constant read a slice step as an index and reached the ELEMENT:
// `len(rows[:])` over a [3][2]int folded to 2, the row's length, once the result of
// len had a type for the fold to be asked through.

var rows [3][2]int

var pool [4]int

func main() {
	// ERROR len is not a constant
	const n = len(rows[:])
	// ERROR len is not a constant
	const m = len(pool[1:])
	// ERROR non-constant array bound
	var bad [len(rows[:])]int
	var buf [len(pool)]int
	println(len(buf), len(bad), len(rows[:]), len(pool[1:3]), cap(rows[1:]))
}
