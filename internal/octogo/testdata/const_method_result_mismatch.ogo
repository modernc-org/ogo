// What a method of a typed CONSTANT hands back goes only where its type does:
// `var u uint32 = pos` for a `pos := Position.Pixel()` of a Pixel, and every
// other place a Pixel is not, was taken -- the variable had only the flags'
// uint32 -- in every release since v0.40.0 (dom83).

type Pixel uint32

type Other uint32

type Box struct{ P Pixel }

type PixelRole uint32

const (
	_ PixelRole = iota
	Position
)

const Format = PixelRole(4)

func (r PixelRole) Pixel() Pixel { return Pixel(r << 2) }

func (r PixelRole) Box() Box { return Box{Pixel(r << 2)} }

func takeU(u uint32) uint32 { return u + 1 }

func main() {
	pos := Position.Pixel()
	// ERROR "cannot use pos of type Pixel as type uint32 in variable declaration"
	var u uint32 = pos
	p := pos
	// ERROR "cannot use p of type Pixel as type PixelRole in variable declaration"
	var r PixelRole = p
	q := Format.Pixel()
	// ERROR "cannot use q of type Pixel as type Other in variable declaration"
	var o Other = q
	// ERROR "mismatched types Pixel and uint32"
	println(q + u)
	e := Position.Pixel()
	f := e
	// ERROR "cannot use f of type Pixel as type uint32 in argument to takeU"
	println(takeU(f))
	b := Position.Box().P
	g := b
	// ERROR "cannot use g of type Pixel as type uint32 in variable declaration"
	var h uint32 = g
	println(r, o, h)
}
