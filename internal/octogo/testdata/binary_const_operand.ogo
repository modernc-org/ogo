// An untyped constant operand of a binary operator takes the other operand's type,
// and is refused when that type cannot hold or represent it -- in every operator,
// on either side, and in a comparison. An integer division by a constant zero is
// refused whatever the dividend. Each mirrors what Go reports. Until this ran, a
// binary operand was the one position a constant met a type in unchecked, so
// `x / (1 << 32)` for an int32 x compiled and computed in 64 bits.

type Celsius int32

const Zero = 0
const Wide = 1 << 32

func typed() {
	var x int32 = 7
	var b byte = 1
	var c Celsius = 1
	var u uint32 = 7
	var i int = 7
	f := 2.5

	// ERROR "constant 4294967296 overflows int32"
	_ = x + 4294967296
	// ERROR "constant 4294967296 overflows int32"
	_ = x + (1 << 32)
	// ERROR "constant 4294967296 overflows int32"
	_ = (1 << 32) + x
	// ERROR "constant 4294967296 overflows int32"
	_ = x * Wide
	// ERROR "constant 8589934591 overflows int32"
	_ = x & 0x1FFFFFFFF
	// ERROR "constant 1099511627776 overflows int32"
	_ = x / (1 << 40)
	// ERROR "constant 4294967296 overflows int32"
	_ = x == (1 << 32)
	// ERROR "constant 4294967296 overflows int32"
	_ = Wide < x
	// ERROR "constant 256 overflows uint8"
	_ = b + 256
	// ERROR "constant -1 overflows uint8"
	_ = b - -1
	// ERROR "constant 4294967296 overflows Celsius"
	_ = c + (1 << 32)
	// ERROR "constant 4294967296 overflows uint32"
	_ = u | (1 << 32)
	// ERROR "constant 4294967296 overflows int"
	_ = i % (1 << 32)
	// ERROR "constant 1.5 truncated to int32"
	_ = x + 1.5
	// ERROR "constant 0.5 truncated to int"
	_ = i > 0.5

	// ERROR "invalid operation: division by zero"
	_ = x / 0
	// ERROR "invalid operation: division by zero"
	_ = x % (1 - 1)
	// ERROR "invalid operation: division by zero"
	_ = u / Zero
	// ERROR "invalid operation: division by zero"
	_ = i / 0.0
	// ERROR "invalid operation: division by zero"
	_ = c % 0

	// Representable, whole, or a float dividend: all fine.
	_ = x + 2147483647
	_ = x - -2147483648
	_ = x + 2.0
	_ = x << 40
	_ = 1 << u
	_ = b + 255
	_ = c * 3
	_ = i == 5
	_ = f / 0.0
	_ = f / 0
	_ = f + 1
	var w int64 = 1
	_ = w / (1 << 32)
	_ = w % Wide
	_ = w == Wide
	_ = u / 4294967295
	_ = u > 0
}

func main() {
	typed()
}
