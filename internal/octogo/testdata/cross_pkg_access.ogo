// A value of an imported package's type exposes only its EXPORTED members to the
// importer: an unexported field or method of another package is inaccessible, and a
// member the type does not have is reported (previously a cross-package field or
// method access was not checked at all). Same-package unexported access stays legal
// and is covered elsewhere; this file is an importer of p.

import "p"

// The exported field and method resolve for an importer.
func ok() {
	var x p.T
	x.F = 1
	println(x.F, x.Get())
}

// Reading an unexported field of an imported type is illegal.
func unexportedFieldRead() {
	var x p.T
	// ERROR "cannot refer to unexported field g of type p.T"
	_ = x.g
}

// Writing one is illegal too.
func unexportedFieldWrite() {
	var x p.T
	// ERROR "cannot refer to unexported field g of type p.T"
	x.g = 2
}

// Calling an unexported method of an imported type is illegal.
func unexportedMethod() {
	var x p.T
	// ERROR "cannot refer to unexported method hidden of type p.T"
	_ = x.hidden()
}

// A field the type does not have is reported.
func noSuchField() {
	var x p.T
	// ERROR "type p.T has no field Missing"
	_ = x.Missing
}

// A method the type does not have is reported.
func noSuchMethod() {
	var x p.T
	// ERROR "type p.T has no method Bogus"
	_ = x.Bogus()
}

// A CALL into another package is checked against that package's signature: the
// argument count always, and an argument's type where the parameter's resolves.
// Before this it reached the C compiler as "Bad number of parameters in call".

func callArity() {
	println(p.Add(1, 2))

	// ERROR too many arguments in call to Add
	println(p.Add(1, 2, 3))

	// ERROR not enough arguments in call to Add
	println(p.Add(1))

	// ERROR cannot use "s" of type string as type int in argument to Add
	println(p.Add("s", 2))
}

// A field can be REACHED without being named: an element of the package's array,
// the result of its function, the result of one of its interface's methods. The
// export rule holds in each -- it used to hold only where a NAME carried the type,
// so every one of these read another package's unexported field.

func reachedFieldRead() {
	// ERROR "cannot refer to unexported field g of type p.T"
	_ = p.Bank[0].g

	// ERROR "cannot refer to unexported field g of type p.T"
	_ = p.Make().g

	var s p.Src
	// ERROR "cannot refer to unexported field g of type p.T"
	_ = s.Fetch().g

	println(p.Bank[0].F, p.Make().F, s.Fetch().F)
}

// A target is reached the same way, and writing is no more permitted than reading.
func reachedFieldWrite() {
	// ERROR "cannot refer to unexported field g of type p.T"
	p.Bank[0].g = 3

	p.Bank[0].F = 4
}
