// A channel is made by make, as in Go, and a declared channel with no value is nil.
// Its cell is static at package level and the frame's in a function, so make
// allocates nothing at run time. A buffered channel is not supported yet, and new has
// no form at all: there is no allocator.

type Pipe chan int

var made = make(chan int)

var madeDefined = make(Pipe)

func viaShortDecl() {
	c := make(chan int)
	select {
	case v := <-c:
		println(v)
	default:
	}
}

func viaArgument(c chan int) {
	println(<-c)
}

func caller() {
	viaArgument(make(chan int, 0))
	viaArgument(made)
}

func buffered() {
	// ERROR "buffered channels are not supported yet"
	c := make(chan int, 4)
	println(<-c)
}

func tooMany() {
	// ERROR "expects 1 or 2 arguments; found 3"
	c := make(chan int, 0, 1)
	println(<-c)
}

func elemOfMake() {
	c := make(chan string)
	// ERROR "cannot use 1"
	c <- 1
}

// A channel declared without a value, which nothing assigns and a send, a receive,
// a close or a range uses, is nil for ever: refused where it is declared.
func neverMade() {
	// ERROR "channel c is never made"
	var c chan int
	c <- 1
}

func neverMadeClosed() {
	// ERROR "channel c is never made"
	var c chan int
	close(c)
}

// ERROR "channel g is never made"
var g chan bool

func useG() { <-g }

// Assigned, addressed or nil on purpose, it is no such channel.
func madeLater() {
	var c chan int
	c = make(chan int)
	select {
	case c <- 1:
	default:
	}
}

func setP(p *chan int) {}

func addressed() {
	var c chan int
	setP(&c)
	<-c
}

func explicitNil() {
	var c chan int = nil
	select {
	case <-c:
	default:
	}
}

// new is refused for the same reason it always was.
func viaNew() {
	// ERROR "dynamic allocation not supported"
	p := new(int)
	println(p)
}

func main() {
	viaShortDecl()
	caller()
	buffered()
	tooMany()
	elemOfMake()
	neverMade()
	neverMadeClosed()
	useG()
	madeLater()
	addressed()
	explicitNil()
	viaNew()
	println(madeDefined == nil)
}
