// A "break" leaves the innermost enclosing "for", "switch" or "select"; a
// "continue" begins the next iteration of the innermost enclosing "for". Either
// may name an enclosing labeled statement instead (see labels.ogo). A "break"
// outside all three, and a "continue" outside a loop, are reported -- a switch or
// select is not something a "continue" can name.

func breaks() {
	i := 0
	for {
		i++
		if i > 2 {
			break
		}
	}
	println(i)
}

func continues() {
	n := 0
	i := 0
	for i < 5 {
		i++
		if i == 2 {
			continue
		}
		n = n + i
	}
	println(n)
}

// A conditionless "for" that can break is no longer a terminating statement, so
// what follows it is reachable.
func reachable_after_break() {
	for {
		break
	}
	println(1)
}

func misplaced() {
	// ERROR "break is not in a loop, switch, or select"
	break
}

func misplaced_continue() {
	x := 1
	switch x {
	case 1:
		// ERROR "continue is not in a loop"
		continue
	}
}

var ch chan int

// A break in a communication clause leaves the select.
func breaks_select() {
	select {
	case v := <-ch:
		println(v)
		break
	default:
		break
	}
	println("after")
}

// A continue names a loop, so a select is no more a target for it than a switch.
func continue_in_select() {
	select {
	case v := <-ch:
		println(v)
		// ERROR "continue is not in a loop"
		continue
	}
}
