// A function literal is an anonymous function. C has no nested functions, and this
// language has no closures to need them, so each literal is lifted to a file-scope
// function and its name is what the expression becomes.
//
// The one rule this adds to Go's: a literal may not read a local of the surrounding
// function. There is no heap to hold a captured frame, and no frame that outlives
// the call, so the pointer would be the only honest part of a closure. Refused where
// it is written rather than left to the C compiler.

type Op func(int, int) int

var gk = 10

var table [2]Op

func apply(op Op, a int, b int) int { return op(a, b) }

func ok() {
	// Bound to a variable, handed to a parameter, held in an element, called
	// where it stands.
	dbl := func(a int) int { return a * 2 }
	println(dbl(21))
	println(apply(func(a int, b int) int { return a - b }, 9, 4))
	table[0] = func(a int, b int) int { return a + b }
	println(table[0](1, 2))
	println(func() int { return 7 } ())

	// A package-level name is not a capture: it is there for every function.
	println(func(a int) int { return a + gk } (5))
}

func captures() {
	k := 5
	var arr [2]int

	// ERROR a function literal may not capture k from the surrounding function
	f := func(a int) int { return a * k }

	// ERROR a function literal may not capture arr from the surrounding function
	g := func() int { return arr[0] }

	println(f(1), g())
}

func params() {
	// A parameter of the surrounding function is a local of it, so it is a capture
	// too -- the literal has parameters of its own, and they are what it may read.
	inner := func(a int) int { return a }
	println(inner(1))
}

// A literal may also stand as the callee of "go" or "defer", where it is lifted the
// same way and reads the same rule. Both take no arguments yet.

var ch chan int

func goDefer() {
	defer func() {
		println("done")
	} ()
	go func() {
		ch <- 1
	} ()
	println(<-ch)
}

func goDeferCaptures() {
	k := 5

	defer func() {
		// ERROR a function literal may not capture k from the surrounding function
		println(k)
	} ()
}

func withParam(n int) {
	// ERROR a function literal may not capture n from the surrounding function
	h := func() int { return n }
	println(h())
}
