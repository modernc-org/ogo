// A struct embeds a NAME: a struct type's -- this package's or, written qualified,
// another's -- or a defined type of any other underlying kind, whose methods
// promote exactly as a struct's do. What stays refused is an interface-typed
// field, a feature of its own not built yet, and a pointer type, which Go refuses
// too; and either is said at the declaration, which beats a diagnostic about some
// later use.

type Leaf struct{ L int }

func (l Leaf) Read() int { return l.L }

type Count int

func (c Count) Val() int { return int(c) }

type Reader interface {
	Read() int
}

type PtrType *int32

type Good struct {
	Leaf
	G int
}

// A defined non-struct type embeds; its method set promotes.
type GoodKind struct {
	Count
	B int
}

type BadIface struct {
	// ERROR cannot embed Reader: an interface-typed field is not supported yet
	Reader
	B int
}

type BadPtr struct {
	// ERROR embedded field type cannot be a pointer
	PtrType
	B int
}

type BadName struct {
	// ERROR undefined: Nope
	Nope
	B int
}

func main() {
	var g Good
	println(g.Read(), g.L, g.G)

	var k GoodKind
	k.Count = 4
	println(k.Val(), int(k.Count), k.B)
}
