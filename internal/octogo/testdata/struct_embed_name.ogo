// A struct embeds a NAME: a struct type's -- this package's or, written qualified,
// another's -- a defined type of any other underlying kind, or an INTERFACE,
// whose method set promotes as a struct's does (an interface's promoted call
// dispatches through whatever the field holds). What stays refused is a pointer
// type, which Go refuses too, said at the declaration rather than as a diagnostic
// about some later use.

type Leaf struct{ L int }

func (l Leaf) Read() int { return l.L }

type Count int

func (c Count) Val() int { return int(c) }

type Reader interface {
	Read() int
}

type PtrType *int32

type Good struct {
	Leaf
	G int
}

// A defined non-struct type embeds; its method set promotes.
type GoodKind struct {
	Count
	B int
}

// An interface embeds; its method set promotes and dispatches through the field.
type WithIface struct {
	Reader
	B int
}

type BadPtr struct {
	// ERROR embedded field type cannot be a pointer
	PtrType
	B int
}

type BadName struct {
	// ERROR undefined: Nope
	Nope
	B int
}

func main() {
	var g Good
	println(g.Read(), g.L, g.G)

	var k GoodKind
	k.Count = 4
	println(k.Val(), int(k.Count), k.B)

	var w WithIface
	w.Reader = &g.Leaf
	println(w.Read(), w.B)
}
